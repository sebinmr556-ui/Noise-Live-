rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: checks if the current authenticated user is an accepted follower of authorId
    function isAcceptedFollower(authorId) {
      return isAuthenticated() && (
        request.auth.uid == authorId ||
        exists(/databases/$(database)/documents/users/$(authorId)/followers/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + authorId)) &&
          get(/databases/$(database)/documents/follows/$(request.auth.uid + "_" + authorId)).data.status == "ACCEPTED"
        )
      );
    }

    // 1. User Profiles & Dynamic Follower/Following Subcollections
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
      );
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && (
          request.auth.uid == followerId ||
          request.auth.uid == userId
        );
      }

      match /following/{followingId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == followingId
        );
      }
    }

    // 2. Follow Relationships & Private Account Follow Requests
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid
      );
    }

    // 3. Global Post Feed & Private Account Visibility
    match /posts/{postId} {
      allow read: if !('isAuthorPrivate' in resource.data) ||
        resource.data.isAuthorPrivate == false ||
        isAcceptedFollower(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // 4. 24-Hour Stories System (Public or Accepted Followers Only)
    match /stories/{storyId} {
      allow read: if !('isAuthorPrivate' in resource.data) ||
        resource.data.isAuthorPrivate == false ||
        isAcceptedFollower(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Ledger Transactions (Append-only)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 6. Voice Chatrooms & Real-Time Room Presence
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        request.auth.token.admin == true ||
        ('coHostIds' in resource.data && request.auth.uid in resource.data.coHostIds) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'charmPoints',
          'totalGiftsCoins',
          'latestGiftEvent',
          'latestReactionEvent',
          'background',
          'customBackgroundUrl',
          'backgroundEnvironment',
          'backgroundTitle',
          'backgroundImageUrl',
          'youtubeStream',
          'localAudioTelecast',
          'ludoGame',
          'ludoGameState',
          'speakers',
          'listeners',
          'room_listeners',
          'participants',
          'room_members',
          'activeMemberCount',
          'stageRequests',
          'lockedSlotIndices',
          'announcement',
          'description',
          'tags',
          'isPrivate',
          'password',
          'moderatorIds',
          'blockedUserIds',
          'isLive',
          'timestamp',
          'updatedAt'
        ])
      );
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      // Real-time room participants & speaker slots subcollection (/rooms/{roomId}/participants/{userId})
      match /participants/{userId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
        );
      }

      // Real-time room presence subcollection (/rooms/{roomId}/room_members/{memberId})
      match /room_members/{memberId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && (
          request.auth.uid == memberId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == memberId ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
        );
      }

      // Real-time in-room chat messages subcollection (/rooms/{roomId}/messages/{messageId})
      match /messages/{messageId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }
    }

    // 7. 1-on-1 Direct Messaging (Strictly Conversation Participants Only)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        ('participants' in resource.data && request.auth.uid in resource.data.participants)
      );
      allow create: if isAuthenticated() &&
        'participants' in request.resource.data &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() &&
        'participants' in resource.data &&
        request.auth.uid in resource.data.participants &&
        'participants' in request.resource.data &&
        request.auth.uid in request.resource.data.participants;
      allow delete: if isAuthenticated() &&
        'participants' in resource.data &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'deliveredAt', 'reactionEmoji']);
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
      }
    }
  }
}
